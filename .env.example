# Copy to .env and fill in. Never commit .env.

# Long-lived token for your Claude Pro subscription.
# Create it on this server with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Optional fallback if Pro limits get in the way. Leave empty to use Pro only.
ANTHROPIC_API_KEY=

# Paths and tuning
DB_PATH=./study.db
PORT=8000
BUFFER_TARGET=100
CLAUDE_MODEL=sonnet
BATCH_SIZE=5
NIGHTLY_CALLS=5
TOPUP_MAX_CALLS=3
RARE_RATE=0.08
